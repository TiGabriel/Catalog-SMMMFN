# Copy to .env.test for `npm test`. Uses a DISPOSABLE local database named catalog_test
# (the test run drops and recreates it). Never point this at a real database.
DATABASE_URL="postgresql://catalog_app:CHANGE_ME@localhost:5432/catalog_test"
MIGRATION_DATABASE_URL="postgresql://catalog_owner:CHANGE_ME@localhost:5432/catalog_test"
DB_APP_ROLE="catalog_app"
APP_ORIGIN="http://localhost:3000"
TRUST_PROXY="false"
COOKIE_SECURE="true"
DISABLE_SCHEDULER="true"
# Password given to the demo/test fixture accounts (any value satisfying the password policy).
DEMO_PASSWORD="CHANGE_ME_Test#2026x"
