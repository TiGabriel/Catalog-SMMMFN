# Conexiunea aplicației (rol cu privilegii minime – fără UPDATE/DELETE pe jurnalul de audit)
DATABASE_URL="postgresql://catalog_app:CHANGE_ME@localhost:5432/catalog"
# Conexiunea pentru migrări (proprietarul schemei)
MIGRATION_DATABASE_URL="postgresql://catalog_owner:CHANGE_ME@localhost:5432/catalog"
# Baza de date „shadow” folosită doar de `prisma migrate dev`
SHADOW_DATABASE_URL="postgresql://catalog_owner:CHANGE_ME@localhost:5432/catalog_shadow"
# Rolul PostgreSQL al aplicației, căruia i se acordă drepturi prin scripts/db-grants.ts
DB_APP_ROLE="catalog_app"

# Originea publică a aplicației (folosită pentru verificarea CSRF a antetului Origin)
APP_ORIGIN="http://localhost:3000"
# true doar dacă aplicația rulează în spatele unui reverse proxy de încredere (X-Forwarded-For)
TRUST_PROXY="false"
# Cookie-uri Secure (obligatoriu true în producție; poate fi false doar local pe http)
COOKIE_SECURE="false"

# Planificatorul intern (trecerea automată la 1 septembrie, curățarea sesiunilor)
DISABLE_SCHEDULER="false"
# Doar în dezvoltare: date demonstrative (npm run db:seed:demo)
ALLOW_DEMO_DATA="true"
DEMO_PASSWORD="CHANGE_ME_Demo#2026x"
