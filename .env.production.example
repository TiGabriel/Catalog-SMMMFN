# ─────────────────────────────────────────────────────────────────────────────
# Catalog SMMMFN – PRODUCTION configuration template.
# Copy to /etc/catalog/catalog.env (chmod 640, owner root:catalog) – NEVER commit the real file.
# Generate passwords with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="production"
# Timezone of the school (dates, 1 September transition, logs)
TZ="Europe/Bucharest"
# The service listens on 127.0.0.1:3000 (see deploy/catalog.service); the reverse proxy is the only public entry point.

# Application connection – least-privilege role (no DELETE on history, no UPDATE on the audit log).
DATABASE_URL="postgresql://catalog_app:<APP_DB_PASSWORD>@127.0.0.1:5432/catalog"
# Schema owner – used ONLY by migrations, grants, backups and CLI tools; not needed by the running service.
MIGRATION_DATABASE_URL="postgresql://catalog_owner:<OWNER_DB_PASSWORD>@127.0.0.1:5432/catalog"
DB_APP_ROLE="catalog_app"

# Exact public origin (scheme + host [+ port]); used for the CSRF Origin check.
APP_ORIGIN="https://catalog.exemplu.ro"
# true: the app is behind our reverse proxy, which sets X-Forwarded-For (enables per-IP limits).
TRUST_PROXY="true"
# Must be true in production (the app refuses to start otherwise).
COOKIE_SECURE="true"

# Background scheduler (automatic 1 September transition, session clean-up). Keep enabled.
DISABLE_SCHEDULER="false"

# Never set these in production:
# ALLOW_DEMO_DATA, DEMO_PASSWORD
