# /etc/systemd/system/catalog.service
[Unit]
Description=Catalog electronic SMMMFN (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=catalog
Group=catalog
WorkingDirectory=/opt/catalog/app
EnvironmentFile=/etc/catalog/catalog.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/catalog/app/.next
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
